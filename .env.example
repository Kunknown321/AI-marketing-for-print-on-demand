# ============================================================
# OtakuPrint Marketing Engine — Environment Configuration
# ============================================================

# REQUIRED: OpenAI API Key (get one at https://platform.openai.com/api-keys)
# You can also use any OpenAI-compatible API (e.g., Groq, Together AI, local Ollama)
OPENAI_API_KEY=your_api_key_here

# Optional: Model configuration
# For free/cheap options: gpt-3.5-turbo, or use Groq/Together AI free tiers
MODEL_NAME=gpt-4

# Optional: Use a different OpenAI-compatible API base URL
# Groq (free tier): https://api.groq.com/openai/v1
# Together AI: https://api.together.xyz/v1
# Local Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional: Max tokens per request
MAX_TOKENS=2000

# Optional: Temperature (creativity level, 0.0-1.0)
TEMPERATURE=0.7
