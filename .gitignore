# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data
data/*.csv
data/*.json
data/*.xlsx
!data/.gitkeep

# Logs
*.log

# Generated output (these are personal to each user)
output/*.json
output/**/*.json
!output/.gitkeep
!output/**/.gitkeep
